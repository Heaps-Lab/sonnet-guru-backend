[mysqld]
# Optimized for dedicated database server (6GB RAM)
# Focused on high-performance database operations

# Memory allocation (4GB buffer pool out of 6GB total)
innodb_buffer_pool_size = 4G
innodb_log_buffer_size = 32M
innodb_log_file_size = 512M

# Connection handling for distributed architecture
max_connections = 1000
max_user_connections = 950
thread_cache_size = 32
table_open_cache = 4000
table_definition_cache = 2000

# Query optimization (disabled query cache for MySQL 8.0)
query_cache_type = 0
query_cache_size = 0

# InnoDB optimization for high concurrent access
innodb_flush_log_at_trx_commit = 2
innodb_file_per_table = 1
innodb_flush_method = O_DIRECT
innodb_io_capacity = 1000
innodb_io_capacity_max = 2000
innodb_read_io_threads = 8
innodb_write_io_threads = 8
innodb_thread_concurrency = 16
innodb_buffer_pool_instances = 4

# Network optimization for remote connections
bind_address = 0.0.0.0
skip_name_resolve = 1
back_log = 500
max_allowed_packet = 64M
max_connect_errors = 10000

# Logging and monitoring
slow_query_log = 1
long_query_time = 1
slow_query_log_file = /var/log/mysql/slow.log
log_queries_not_using_indexes = 0

# Replication settings (if setting up master-slave)
log_bin = mysql-bin
binlog_format = ROW
expire_logs_days = 7
max_binlog_size = 100M
sync_binlog = 1
server_id = 1

# Character set and timezone
character_set_server = utf8mb4
collation_server = utf8mb4_unicode_ci
default_time_zone = '+00:00'

# Temporary tables
tmp_table_size = 256M
max_heap_table_size = 256M

# MyISAM (if any tables still use it)
key_buffer_size = 64M

# Security
local_infile = 0