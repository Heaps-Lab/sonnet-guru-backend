[mysqld]
# Memory settings optimized for 6GB RAM VPS (1.5GB allocated to MySQL)
innodb_buffer_pool_size = 1G
innodb_log_buffer_size = 16M
innodb_log_file_size = 256M

# Connection settings
max_connections = 100
max_user_connections = 95
thread_cache_size = 16
table_open_cache = 2000
table_definition_cache = 1000

# Query cache (disabled for better performance in MySQL 8.0)
query_cache_type = 0
query_cache_size = 0

# InnoDB settings for better performance
innodb_flush_log_at_trx_commit = 2
innodb_file_per_table = 1
innodb_flush_method = O_DIRECT
innodb_io_capacity = 1000
innodb_read_io_threads = 4
innodb_write_io_threads = 4

# Temporary table settings
tmp_table_size = 64M
max_heap_table_size = 64M

# MyISAM settings
key_buffer_size = 32M

# Slow query log for monitoring
slow_query_log = 1
long_query_time = 2
slow_query_log_file = /var/log/mysql/slow.log

# Binary log settings
binlog_format = ROW
expire_logs_days = 7
max_binlog_size = 100M

# Character set
character_set_server = utf8mb4
collation_server = utf8mb4_unicode_ci

# Time zone
default_time_zone = '+00:00'

# Security settings
skip_name_resolve = 1
bind_address = 0.0.0.0